    {
      "name": "API Performance Report",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.variables.set(\r",
              "    \"apiTimings\",\r",
              "    pm.collectionVariables.get(\"apiTimings\")\r",
              ");\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "id": "91067aec-432e-4ee7-92e7-517819b29028"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let report = JSON.parse(pm.collectionVariables.get(\"apiTimings\") || \"{}\");\r",
              "\r",
              "pm.globals.set(\"performance35\", JSON.stringify({\r",
              "    serverName: \"192.168.10.35\",\r",
              "    results: report\r",
              "}));\r",
              "\r",
              "pm.globals.set(\r",
              "    \"analytics35\",\r",
              "    pm.collectionVariables.get(\"analytics\")\r",
              ");\r",
              "\r",
              "console.log(\"Analytics35 Saved\");\r",
              "console.log(pm.globals.get(\"analytics35\"));\r",
              "\r",
              "console.log(\"Performance35 Saved\");\r",
              "console.log(pm.globals.get(\"performance35\"));\r",
              "\r",
              "Object.keys(report).forEach(api => {\r",
              "\r",
              "    pm.test(`${api} - Avg ${report[api].averageTime} ms`, function () {\r",
              "        pm.expect(true).to.be.true;\r",
              "    });\r",
              "\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "id": "d74e80b2-9bd6-4ace-a92f-6701bc15ef3c"
          }
        }
