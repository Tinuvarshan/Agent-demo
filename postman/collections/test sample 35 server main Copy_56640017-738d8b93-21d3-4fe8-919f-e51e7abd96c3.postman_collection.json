  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "console.log(\r",
          "    \"Iteration:\", pm.info.iteration,\r",
          "    \"Request:\", pm.info.requestName\r",
          ");\r",
          "\r",
          "// Clear timings ONLY once\r",
          "if (\r",
          "    pm.info.iteration === 0 &&\r",
          "    pm.info.requestName === \"Update User\"\r",
          ") {\r",
          "    pm.collectionVariables.set(\"apiTimings\", \"{}\");\r",
          "    console.log(\"apiTimings cleared.\");\r",
          "}\r",
          "\r",
          "if (\r",
          "    pm.info.iteration === 0 &&\r",
          "    pm.info.requestName === \"Update User\"\r",
          ") {\r",
          "    pm.collectionVariables.set(\"analytics\", \"[]\");\r",
          "}"
        ],
        "id": "87e2d7df-467e-4ccf-9b43-d4595eb82572"
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "const ignoreRequests = [\r",
          "    \"API Performance Report\",\r",
          "    \"Compare Performance\"\r",
          "];\r",
          "\r",
          "if (ignoreRequests.includes(pm.info.requestName)) {\r",
          "    return;\r",
          "}\r",
          "\r",
          "let apiTimings = JSON.parse(pm.collectionVariables.get(\"apiTimings\") || \"{}\");\r",
          "\r",
          "let analytics =\r",
          "JSON.parse(pm.collectionVariables.get(\"analytics\") || \"[]\");\r",
          "\r",
          "const api = pm.info.requestName;\r",
          "\r",
          "if (!apiTimings[api]) {\r",
          "\r",
          "    apiTimings[api] = {\r",
          "\r",
          "        runs: 0,\r",
          "        totalTime: 0,\r",
          "        averageTime: 0,\r",
          "        minTime: Number.MAX_SAFE_INTEGER,\r",
          "        maxTime: 0,\r",
          "        latestTime: 0,\r",
          "        statusCode: 0,\r",
          "\r",
          "        minTimestamp: \"\",\r",
          "        maxTimestamp: \"\"\r",
          "\r",
          "    };\r",
          "\r",
          "}\r",
          "\r",
          "const current = pm.response.responseTime;\r",
          "\r",
          "apiTimings[api].runs++;\r",
          "\r",
          "apiTimings[api].totalTime += current;\r",
          "\r",
          "apiTimings[api].latestTime = current;\r",
          "\r",
          "analytics.push({\r",
          "\r",
          "    api: api,\r",
          "\r",
          "    timestamp: Date.now(),\r",
          "\r",
          "    responseTime: current,\r",
          "\r",
          "    statusCode: pm.response.code,\r",
          "\r",
          "    success: pm.response.code >= 200 && pm.response.code < 300,\r",
          "    \r",
          "    server: pm.environment.get(\"serverName\") || \"\"\r",
          "\r",
          "});\r",
          "\r",
          "apiTimings[api].statusCode = pm.response.code;\r",
          "\r",
          "if (current < apiTimings[api].minTime) {\r",
          "\r",
          "    apiTimings[api].minTime = current;\r",
          "    apiTimings[api].minTimestamp = new Date().toLocaleString();\r",
          "\r",
          "}\r",
          "\r",
          "if (current > apiTimings[api].maxTime) {\r",
          "\r",
          "    apiTimings[api].maxTime = current;\r",
          "    apiTimings[api].maxTimestamp = new Date().toLocaleString();\r",
          "\r",
          "}\r",
          "\r",
          "apiTimings[api].averageTime =\r",
          "Math.round(\r",
          "    apiTimings[api].totalTime /\r",
          "    apiTimings[api].runs\r",
          ");\r",
          "\r",
          "pm.collectionVariables.set(\r",
          "    \"apiTimings\",\r",
          "    JSON.stringify(apiTimings)\r",
          ");\r",
          "\r",
          "pm.collectionVariables.set(\r",
          "\"analytics\",\r",
          "JSON.stringify(analytics)\r",
          ");\r",
          ""
        ],
        "id": "e04f8f37-98f2-47c7-b931-370254d8ea03"
      }
    }
