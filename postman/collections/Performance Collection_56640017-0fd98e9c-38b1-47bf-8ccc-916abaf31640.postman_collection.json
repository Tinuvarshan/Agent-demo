    {
      "name": "Issuance OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let response = pm.response.text();\r",
              " \r",
              "console.log(\"===== SOAP RESPONSE =====\");\r",
              "console.log(response);\r",
              " \r",
              "let otpMatch = response.match(/<.*?:otp>(.*?)<\\/.*?:otp>/);\r",
              " \r",
              "if (otpMatch) {\r",
              "    let otp = otpMatch[1].trim();\r",
              " \r",
              "    console.log(\"Extracted OTP:\", otp);\r",
              " \r",
              "    pm.collectionVariables.set(\"otp\", otp);\r",
              " \r",
              "    console.log(\"Stored OTP:\", pm.collectionVariables.get(\"otp\"));\r",
              " \r",
              "    pm.test(\"OTP extracted successfully\", function () {\r",
              "        pm.expect(otp).to.not.be.empty;\r",
              "    });\r",
              "} else {\r",
              "    console.log(\"OTP NOT FOUND\");\r",
              "}\r",
              " "
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "id": "6112070b-f5bd-442a-a8df-6ac369f32715"
          }
        }
      ],
