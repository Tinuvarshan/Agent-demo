              "pm.variables.set(\r",
              "    \"apiTimings\",\r",
              "    pm.collectionVariables.get(\"apiTimings\")\r",
              ");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "id": "26fbad4a-486f-4850-9732-59982af05410"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let report = JSON.parse(pm.collectionVariables.get(\"apiTimings\") || \"{}\");\r",
              "\r",
              "pm.globals.set(\"performance43\", JSON.stringify({\r",
              "    serverName: \"192.168.10.43\",\r",
              "    results: report\r",
              "}));\r",
              "\r",
              "// Save analytics for comparison graphs\r",
              "pm.globals.set(\r",
              "    \"analytics43\",\r",
              "    pm.collectionVariables.get(\"analytics\")\r",
              ");\r",
              "\r",
              "console.log(\"Analytics43 Saved\");\r",
              "console.log(pm.globals.get(\"analytics43\"));\r",
              "\r",
              "console.log(\"Performance43 Saved\");\r",
              "console.log(pm.globals.get(\"performance43\"));\r",
              "\r",
              "Object.keys(report).forEach(api => {\r",
              "\r",
              "    pm.test(`${api} - Avg ${report[api].averageTime} ms`, function () {\r",
              "        pm.expect(true).to.be.true;\r",
              "    });\r",
              "\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
