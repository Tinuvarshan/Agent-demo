    {
      "name": "Compare Performance",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const performance35 = pm.globals.get(\"performance35\");\r",
              "const performance43 = pm.globals.get(\"performance43\");\r",
              "\r",
              "if (!performance35) {\r",
              "    throw new Error(\"Run API Performance Report for Server 35 first.\");\r",
              "}\r",
              "\r",
              "if (!performance43) {\r",
              "    throw new Error(\"Run API Performance Report for Server 43 first.\");\r",
              "}\r",
              "\r",
              "const serverA = JSON.parse(performance35);\r",
              "const serverB = JSON.parse(performance43);\r",
              "\r",
              "const SLA = 500;\r",
              "\r",
              "// Read analytics collected during the run\r",
              "\r",
              "const analytics35 = JSON.parse(\r",
              "    pm.globals.get(\"analytics35\") || \"[]\"\r",
              ");\r",
              "\r",
              "const analytics43 = JSON.parse(\r",
              "    pm.globals.get(\"analytics43\") || \"[]\"\r",
              ");\r",
              "\r",
              "let report = [];\r",
              "\r",
              "// API-wise graph data\r",
              "let apiGraph = {};\r",
              "\r",
              "function collectAPIAnalytics(analytics, server) {\r",
              "\r",
              "    analytics.forEach(item => {\r",
              "\r",
              "        if (!apiGraph[item.api]) {\r",
              "\r",
              "            apiGraph[item.api] = {\r",
              "\r",
              "                server35: {\r",
              "                    requests: 0,\r",
              "                    totalResponse: 0,\r",
              "                    errors: 0\r",
              "                },\r",
              "\r",
              "                server43: {\r",
              "                    requests: 0,\r",
              "                    totalResponse: 0,\r",
              "                    errors: 0\r",
              "                }\r",
              "\r",
              "            };\r",
              "\r",
              "        }\r",
              "\r",
              "        const target =\r",
              "            server === \"35\"\r",
              "                ? apiGraph[item.api].server35\r",
              "                : apiGraph[item.api].server43;\r",
              "\r",
              "        target.requests++;\r",
              "        target.totalResponse += item.responseTime;\r",
              "\r",
              "        if (!item.success) {\r",
              "            target.errors++;\r",
              "        }\r",
              "\r",
              "    });\r",
              "\r",
              "}\r",
              "\r",
              "console.log(\"========================================================\");\r",
              "console.log(\"          API PERFORMANCE COMPARISON REPORT\");\r",
              "console.log(\"========================================================\");\r",
              "console.log(\"Server A          :\", serverA.serverName);\r",
              "console.log(\"Server B          :\", serverB.serverName);\r",
              "console.log(\"SLA Threshold     :\", SLA + \" ms\");\r",
              "console.log(\"Comparison Time   :\", new Date().toLocaleString());\r",
              "console.log(\"========================================================\");\r",
              "\r",
              "let slowestApi = \"\";\r",
              "let slowestServer = \"\";\r",
              "let slowestTime = 0;\r",
              "\r",
              "let fastestApi = \"\";\r",
              "let fastestServer = \"\";\r",
              "let fastestTime = Number.MAX_VALUE;\r",
              "\r",
              "let slowestTimestamp = \"\";\r",
              "let fastestTimestamp = \"\";\r",
              "\r",
              "function processAnalytics(analytics, requests, responses, errors) {\r",
              "\r",
              "    analytics.forEach(item => {\r",
              "\r",
              "        const second = Math.floor(item.timestamp / 1000);\r",
              "\r",
              "        requests[second] = (requests[second] || 0) + 1;\r",
              "\r",
              "        if (!responses[second]) {\r",
              "            responses[second] = {\r",
              "                total: 0,\r",
              "                count: 0\r",
              "            };\r",
              "        }\r",
              "\r",
              "        responses[second].total += item.responseTime;\r",
              "        responses[second].count++;\r",
              "\r",
              "        if (!errors[second]) {\r",
              "            errors[second] = 0;\r",
              "        }\r",
              "\r",
              "        if (!item.success) {\r",
              "            errors[second]++;\r",
              "        }\r",
              "\r",
              "    });\r",
              "\r",
              "}\r",
              "\r",
              "collectAPIAnalytics(analytics35, \"35\");\r",
              "collectAPIAnalytics(analytics43, \"43\");\r",
              "\r",
              "const graphLabels = Object.keys(apiGraph);\r",
              "\r",
              "const reqPerSec35 = [];\r",
              "const reqPerSec43 = [];\r",
              "\r",
              "const avgResponse35 = [];\r",
              "const avgResponse43 = [];\r",
              "\r",
              "const errorPerSec35 = [];\r",
              "const errorPerSec43 = [];\r",
              "\r",
              "graphLabels.forEach(api => {\r",
              "\r",
              "    const s35 = apiGraph[api].server35;\r",
              "    const s43 = apiGraph[api].server43;\r",
              "\r",
              "    reqPerSec35.push(s35.requests);\r",
              "\r",
              "    reqPerSec43.push(s43.requests);\r",
              "\r",
              "    avgResponse35.push(\r",
              "        s35.requests\r",
              "            ? Math.round(s35.totalResponse / s35.requests)\r",
              "            : 0\r",
              "    );\r",
              "\r",
              "    avgResponse43.push(\r",
              "        s43.requests\r",
              "            ? Math.round(s43.totalResponse / s43.requests)\r",
              "            : 0\r",
              "    );\r",
              "\r",
              "    errorPerSec35.push(s35.errors);\r",
              "    errorPerSec43.push(s43.errors);\r",
              "\r",
              "});\r",
              "\r",
              "const displayLabels = graphLabels;\r",
              "\r",
              "Object.keys(serverA.results).forEach(api => {\r",
              "\r",
              "    if (!serverB.results[api]) {\r",
              "        return;\r",
              "    }\r",
              "\r",
              "    const A = serverA.results[api];\r",
              "    const B = serverB.results[api];\r",
              "\t\r",
              "\t// Slowest API\r",
              "\t\r",
              "\tif (A.averageTime > slowestTime) {\r",
              "\t\tslowestTime = A.averageTime;\r",
              "\t\tslowestApi = api;\r",
              "\t\tslowestServer = serverA.serverName;\r",
              "        slowestTimestamp = A.maxTimestamp;\r",
              "\t}\r",
              "\r",
              "\tif (B.averageTime > slowestTime) {\r",
              "\t\tslowestTime = B.averageTime;\r",
              "\t\tslowestApi = api;\r",
              "\t\tslowestServer = serverB.serverName;\r",
              "        slowestTimestamp = B.maxTimestamp;\r",
              "\t}\r",
              "\r",
              "\t// Fastest API\r",
              "\t\r",
              "\tif (A.averageTime < fastestTime) {\r",
              "\t\tfastestTime = A.averageTime;\r",
              "\t\tfastestApi = api;\r",
              "\t\tfastestServer = serverA.serverName;\r",
              "        fastestTimestamp = A.minTimestamp;\r",
              "\r",
              "\t}\r",
              "\r",
              "\tif (B.averageTime < fastestTime) {\r",
              "\t\tfastestTime = B.averageTime;\r",
              "\t\tfastestApi = api;\r",
              "\t\tfastestServer = serverB.serverName;\r",
              "        fastestTimestamp = B.minTimestamp;\r",
              "\t}\r",
              "\r",
              "    const difference = Math.abs(A.averageTime - B.averageTime);\r",
              "\r",
              "    const slowerServer =\r",
              "        A.averageTime > B.averageTime\r",
              "            ? serverA.serverName\r",
              "            : serverB.serverName;\r",
              "\r",
              "    let slaStatus = \"PASS\";\r",
              "    let slaDetails = \"No SLA Breach\";\r",
              "\r",
              "    if (A.averageTime > SLA && B.averageTime > SLA) {\r",
              "\r",
              "        slaStatus = \"FAIL\";\r",
              "\r",
              "        slaDetails =\r",
              "            `Both Servers breached SLA (${serverA.serverName}: ${A.averageTime} ms, ${serverB.serverName}: ${B.averageTime} ms)`;\r",
              "\r",
              "    }\r",
              "    else if (A.averageTime > SLA) {\r",
              "\r",
              "        slaStatus = \"FAIL\";\r",
              "\r",
              "        slaDetails =\r",
              "            `${serverA.serverName} breached SLA (${A.averageTime} ms)`;\r",
              "\r",
              "    }\r",
              "    else if (B.averageTime > SLA) {\r",
              "\r",
              "        slaStatus = \"FAIL\";\r",
              "\r",
              "        slaDetails =\r",
              "            `${serverB.serverName} breached SLA (${B.averageTime} ms)`;\r",
              "\r",
              "    }\r",
              "\r",
              "    let httpStatus = \"PASS\";\r",
              "    let httpDetails = \"HTTP 200\";\r",
              "\r",
              "    if (A.statusCode !== 200 || B.statusCode !== 200) {\r",
              "\r",
              "        httpStatus = \"FAIL\";\r",
              "\r",
              "        httpDetails =\r",
              "            `${serverA.serverName}: ${A.statusCode}, ${serverB.serverName}: ${B.statusCode}`;\r",
              "\r",
              "    }\r",
              "\r",
              "    console.log(\"--------------------------------------\");\r",
              "    console.log(\"API              :\", api);\r",
              "    console.log(\"Server A         :\", A.averageTime + \" ms\");\r",
              "    console.log(\"Server B         :\", B.averageTime + \" ms\");\r",
              "    console.log(\"Difference       :\", difference + \" ms\");\r",
              "    console.log(\"Slower Server    :\", slowerServer);\r",
              "    console.log(\"SLA Status       :\", slaStatus);\r",
              "    console.log(\"SLA Details      :\", slaDetails);\r",
              "    console.log(\"HTTP Status      :\", httpStatus);\r",
              "    console.log(\"HTTP Details     :\", httpDetails);\r",
              "\r",
              "    report.push({\r",
              "\r",
              "    API: api,\r",
              "\r",
              "    Runs: A.runs,\r",
              "\r",
              "    AvgA: A.averageTime,\r",
              "    AvgB: B.averageTime,\r",
              "\r",
              "    FastestA: A.minTime,\r",
              "    SlowestA: A.maxTime,\r",
              "\r",
              "    FastestB: B.minTime,\r",
              "    SlowestB: B.maxTime,\r",
              "\r",
              "    Difference: difference,\r",
              "\r",
              "    SlowerServer: slowerServer,\r",
              "\r",
              "    SLAStatus: slaStatus,\r",
              "\tSLADetails: slaDetails,\r",
              "\r",
              "    HTTPStatus: httpStatus\r",
              "\r",
              "    });\r",
              "\r",
              "    delete serverA.results[\"API Performance Report\"];\r",
              "delete serverB.results[\"API Performance Report\"];\r",
              "\r",
              "delete serverA.results[\"Compare Performance\"];\r",
              "delete serverB.results[\"Compare Performance\"];\r",
              "\r",
              "});\r",
              "\r",
              "console.log(\"============================================\");\r",
              "console.log(\"SUMMARY\");\r",
              "console.log(\"============================================\");\r",
              "\r",
              "console.log(\"Total APIs      :\", report.length);\r",
              "console.log(\"SLA Failures    :\", report.filter(x => x.SLAStatus === \"FAIL\").length);\r",
              "console.log(\"HTTP Failures   :\", report.filter(x => x.HTTPStatus === \"FAIL\").length);\r",
              "\r",
              "pm.globals.set(\"comparisonReport\", JSON.stringify(report, null, 2));\r",
              "\r",
