  "event": [
    {
      "listen": "prerequest",
      "script": {
        "id": "f7849d41-2546-4b59-9d08-20e81a74e61e",
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "// ============================================================\r",
          "// POSTMAN API SECURITY PRE-VALIDATION + ELK LOGGING\r",
          "// ============================================================\r",
          "\r",
          "\r",
          "\r",
          "// --------------------------------------------------------\r",
          "// SQL Injection-like Input\r",
          "//\r",
          "// XSS-like Input\r",
          "//\r",
          "// Path Traversal\r",
          "//\r",
          "// Command Injection-like Input\r",
          "//\r",
          "// HTML Event Injection\r",
          "//\r",
          "// Encoded Script Pattern\r",
          "//\r",
          "// Excessively Large Request Body\r",
          "//\r",
          "// --------------------------------------------------------\r",
          "\r",
          "\r",
          "// ============================================================\r",
          "// CONFIGURATION\r",
          "// ============================================================\r",
          "\r",
          "const SECURITY_ENABLED = true;\r",
          "\r",
          "// Your existing ELK / Logstash endpoint\r",
          "const ELK_ENDPOINT =\r",
          "    \"http://localhost:5000\";\r",
          "\r",
          "\r",
          "// ============================================================\r",
          "// REQUEST INFORMATION\r",
          "// ============================================================\r",
          "\r",
          "const requestName =\r",
          "    pm.info.requestName || \"Unknown Request\";\r",
          "\r",
          "const collectionName =\r",
          "    pm.info.collectionName || \"Unknown Collection\";\r",
          "\r",
          "const method =\r",
          "    pm.request.method || \"\";\r",
          "\r",
          "const requestUrl =\r",
          "    pm.request.url\r",
          "        ? pm.request.url.toString()\r",
          "        : \"\";\r",
          "\r",
          "\r",
          "// ============================================================\r",
          "// READ REQUEST BODY\r",
          "// ============================================================\r",
          "\r",
          "let requestBody = \"\";\r",
          "\r",
          "if (pm.request.body) {\r",
          "\r",
          "    // --------------------------------------------------------\r",
          "    // RAW BODY\r",
          "    // --------------------------------------------------------\r",
          "\r",
          "    if (pm.request.body.mode === \"raw\") {\r",
          "\r",
          "        requestBody =\r",
          "            pm.request.body.raw || \"\";\r",
          "\r",
          "    }\r",
          "\r",
          "    // --------------------------------------------------------\r",
          "    // URL ENCODED BODY\r",
          "    // --------------------------------------------------------\r",
          "\r",
          "    else if (pm.request.body.mode === \"urlencoded\") {\r",
          "\r",
          "        try {\r",
          "\r",
          "            requestBody =\r",
          "                JSON.stringify(\r",
          "                    pm.request.body.urlencoded.toObject()\r",
          "                );\r",
          "\r",
          "        } catch (error) {\r",
          "\r",
          "            requestBody = \"\";\r",
          "\r",
          "        }\r",
          "    }\r",
          "\r",
          "    // --------------------------------------------------------\r",
          "    // FORM DATA\r",
          "    // --------------------------------------------------------\r",
          "\r",
          "    else if (pm.request.body.mode === \"formdata\") {\r",
          "\r",
          "        try {\r",
          "\r",
          "            requestBody =\r",
          "                JSON.stringify(\r",
          "                    pm.request.body.formdata.toObject()\r",
          "                );\r",
          "\r",
          "        } catch (error) {\r",
          "\r",
          "            requestBody = \"\";\r",
          "\r",
          "        }\r",
          "    }\r",
          "}\r",
          "\r",
          "\r",
          "// ============================================================\r",
          "// READ REQUEST HEADERS\r",
          "// ============================================================\r",
          "//\r",
          "// Sensitive headers are REDACTED so that secrets are never\r",
          "// sent to ELK.\r",
          "// ============================================================\r",
          "\r",
          "let requestHeaders = {};\r",
          "\r",
          "pm.request.headers.each(function (header) {\r",
          "\r",
          "    const name =\r",
          "        header.key.toLowerCase();\r",
          "\r",
          "    if (\r",
          "        name === \"authorization\" ||\r",
          "        name === \"x-api-key\" ||\r",
          "        name === \"api-key\" ||\r",
          "        name === \"cookie\" ||\r",
          "        name === \"set-cookie\"\r",
          "    ) {\r",
          "\r",
          "        requestHeaders[header.key] =\r",
          "            \"[REDACTED]\";\r",
          "\r",
          "    } else {\r",
          "\r",
          "        requestHeaders[header.key] =\r",
          "            header.value;\r",
          "    }\r",
          "});\r",
          "\r",
          "\r",
          "// ============================================================\r",
          "// CREATE SECURITY SCAN INPUT\r",
          "// ============================================================\r",
          "//\r",
          "// The scanner checks:\r",
          "// - URL\r",
          "// - Request body\r",
          "// - Headers\r",
          "//\r",
          "// ============================================================\r",
          "\r",
          "const securityInput = [\r",
          "\r",
          "    requestUrl,\r",
          "\r",
          "    requestBody,\r",
          "\r",
          "    JSON.stringify(requestHeaders)\r",
          "\r",
          "].join(\"\\n\");\r",
          "\r",
          "\r",
          "// ============================================================\r",
          "// SECURITY RULES\r",
          "// ============================================================\r",
          "//\r",
          "\r",
          "const securityRules = [\r",
          "\r",
          "    // --------------------------------------------------------\r",
          "    // SQL INJECTION-LIKE INPUT\r",
          "    // --------------------------------------------------------\r",
          "\r",
          "    {\r",
          "        name: \"SQL Injection Input\",\r",
          "\r",
          "        pattern:\r",
          "            /(\\bunion\\b[\\s\\S]*\\bselect\\b)|(\\bor\\b\\s+['\"]?\\w+['\"]?\\s*=\\s*['\"]?\\w+)|(--\\s*$)|(['\"]\\s*or\\s*['\"]?1['\"]?\\s*=\\s*['\"]?1)/i\r",
          "    },\r",
          "\r",
          "\r",
          "    // --------------------------------------------------------\r",
          "    // XSS-LIKE INPUT\r",
          "    // --------------------------------------------------------\r",
          "\r",
          "    {\r",
          "        name: \"XSS Input\",\r",
          "\r",
          "        pattern:\r",
          "            /<\\s*script\\b|<\\/\\s*script\\s*>|javascript\\s*:/i\r",
          "    },\r",
          "\r",
          "\r",
          "    // --------------------------------------------------------\r",
          "    // PATH TRAVERSAL\r",
          "    // --------------------------------------------------------\r",
          "\r",
          "    {\r",
          "        name: \"Path Traversal\",\r",
          "\r",
          "        pattern:\r",
          "            /\\.\\.[\\/\\\\]/\r",
          "    },\r",
          "\r",
          "\r",
          "    // --------------------------------------------------------\r",
          "    // COMMAND INJECTION-LIKE INPUT\r",
          "    // --------------------------------------------------------\r",
          "\r",
          "    {\r",
          "        name: \"Command Injection Input\",\r",
          "\r",
          "        pattern:\r",
          "            /(?:^|[;&|])\\s*(?:bash|sh|cmd|powershell|curl|wget)\\b/i\r",
          "    },\r",
          "\r",
          "\r",
          "    // --------------------------------------------------------\r",
          "    // HTML EVENT INJECTION\r",
          "    // --------------------------------------------------------\r",
          "\r",
          "    {\r",
          "        name: \"HTML Event Injection\",\r",
          "\r",
          "        pattern:\r",
          "            /\\bon(?:error|load|click|mouseover)\\s*=/i\r",
          "    },\r",
          "\r",
          "\r",
          "    // --------------------------------------------------------\r",
          "    // ENCODED SCRIPT\r",
          "    // --------------------------------------------------------\r",
          "\r",
          "    {\r",
          "        name: \"Encoded Script Pattern\",\r",
          "\r",
          "        pattern:\r",
          "            /%3c\\s*script|%3cscript|%3c%2fscript/i\r",
          "    }\r",
          "\r",
          "];\r",
          "\r",
          "\r",
          "// ============================================================\r",
          "// LARGE REQUEST BODY CHECK\r",
          "// ============================================================\r",
          "\r",
          "const MAX_BODY_SIZE = 100000;\r",
          "\r",
          "if (requestBody.length > MAX_BODY_SIZE) {\r",
          "\r",
          "    securityRules.push({\r",
          "\r",
          "        name: \"Excessively Large Request Body\",\r",
          "\r",
          "        pattern: /[\\s\\S]/\r",
          "\r",
          "    });\r",
          "}\r",
          "\r",
          "\r",
          "// ============================================================\r",
          "// RUN SECURITY SCAN\r",
          "// ============================================================\r",
          "\r",
          "let detectedThreat = null;\r",
          "\r",
          "for (const rule of securityRules) {\r",
          "\r",
          "    if (rule.pattern.test(securityInput)) {\r",
          "\r",
          "        detectedThreat = rule.name;\r",
          "\r",
          "        break;\r",
          "    }\r",
          "}\r",
          "\r",
          "\r",
          "// ============================================================\r",
          "// SECURITY VALIDATION DISABLED\r",
          "// ============================================================\r",
          "\r",
          "if (!SECURITY_ENABLED) {\r",
          "\r",
          "    console.log(\r",
          "        \"⚠️ Security validation is disabled.\"\r",
          "    );\r",
          "\r",
          "}\r",
          "\r",
          "\r",
          "// ============================================================\r",
          "// SECURITY VALIDATION PASSED\r",
          "// ============================================================\r",
          "\r",
          "else if (!detectedThreat) {\r",
          "\r",
          "    console.log(\r",
          "        \"✅ SECURITY CHECK PASSED:\",\r",
          "        requestName\r",
          "    );\r",
          "\r",
          "}\r",
          "\r",
          "// ============================================================\r",
          "// SECURITY THREAT DETECTED\r",
          "// ============================================================\r",
          "\r",
          "if (SECURITY_ENABLED && detectedThreat) {\r",
          "\r",
          "    console.error(\r",
          "        \"==============================================\"\r",
          "    );\r",
          "\r",
          "    console.error(\r",
          "        \"🚨 SECURITY THREAT DETECTED\"\r",
          "    );\r",
          "\r",
          "    console.error(\r",
          "        \"Request:\",\r",
          "        requestName\r",
          "    );\r",
          "\r",
          "    console.error(\r",
          "        \"Method:\",\r",
          "        method\r",
          "    );\r",
          "\r",
          "    console.error(\r",
          "        \"Threat:\",\r",
          "        detectedThreat\r",
          "    );\r",
          "\r",
          "    console.error(\r",
          "        \"Action: REQUEST BLOCKED\"\r",
          "    );\r",
          "\r",
          "    console.error(\r",
          "        \"==============================================\"\r",
          "    );\r",
          "\r",
          "\r",
          "    // ========================================================\r",
          "    // CREATE SECURITY EVENT\r",
          "    // ========================================================\r",
          "\r",
          "    const securityEvent = {\r",
          "\r",
          "        eventType: \"API_SECURITY_THREAT\",\r",
          "\r",
          "        timestamp: new Date().toISOString(),\r",
          "\r",
          "        source: \"Postman\",\r",
          "\r",
          "        collection:\r",
          "            pm.info.collectionName || \"Unknown Collection\",\r",
          "\r",
          "        apiName:\r",
          "            pm.info.requestName || \"Unknown Request\",\r",
          "\r",
          "        method:\r",
          "            pm.request.method,\r",
          "\r",
          "        apiUrl:\r",
          "            pm.request.url.toString(),\r",
          "\r",
          "        threatType:\r",
          "            detectedThreat,\r",
          "\r",
          "        action:\r",
          "            \"BLOCKED\",\r",
          "\r",
          "        securityStatus:\r",
          "            \"FAIL\"\r",
          "    };\r",
          "\r",
          "\r",
          "    // ========================================================\r",
          "    // SEND SECURITY EVENT TO ELK\r",
          "    // ========================================================\r",
          "\r",
          "    pm.sendRequest({\r",
          "\r",
          "        url:\r",
          "            \"http://localhost:5000\",\r",
          "\r",
          "        method:\r",
          "            \"POST\",\r",
          "\r",
          "        header: {\r",
          "            \"Content-Type\": \"application/json\"\r",
          "        },\r",
          "\r",
          "        body: {\r",
          "\r",
          "            mode: \"raw\",\r",
          "\r",
          "            raw:\r",
          "                JSON.stringify(securityEvent)\r",
          "        }\r",
          "\r",
          "    }, function (error, response) {\r",
          "\r",
          "        if (error) {\r",
          "\r",
          "            console.error(\r",
          "                \"❌ Failed to send security event to ELK:\",\r",
          "                error\r",
          "            );\r",
          "\r",
          "        } else {\r",
          "\r",
          "            console.log(\r",
          "                \"📊 Security event sent to ELK\"\r",
          "            );\r",
          "\r",
          "            if (response) {\r",
          "\r",
          "                console.log(\r",
          "                    \"ELK Response Status:\",\r",
          "                    response.code\r",
          "                );\r",
          "            }\r",
          "        }\r",
          "\r",
          "    });\r",
          "\r",
          "\r",
          "    // ========================================================\r",
          "    // BLOCK CURRENT REQUEST\r",
          "    // ========================================================\r",
          "\r",
          "    pm.execution.skipRequest();\r",
          "\r",
          "    console.error(\r",
          "        \"🛑 Request skipped because a security threat was detected.\"\r",
          "    );\r",
          "\r",
          "    console.error(\r",
          "        \"Request:\",\r",
          "        pm.info.requestName\r",
          "    );\r",
          "\r",
          "    console.error(\r",
          "        \"Threat:\",\r",
          "        detectedThreat\r",
          "    );\r",
          "\r",
          "    console.error(\r",
          "        \"Action: REQUEST BLOCKED\"\r",
          "    );\r",
          "\r",
          "} // "
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "id": "331cd37b-5e29-4810-b602-1661a889f87d",
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "const SLA_LIMIT = 1000;\r",
          "let elkData = {\r",
          "    apiName: pm.info.requestName,\r",
          "    method: pm.request.method,\r",
          "    apiUrl: pm.request.url.toString(),\r",
          "    statusCode: pm.response.code,\r",
          "    responseTime: pm.response.responseTime,\r",
          "\r",
          "    // Existing API Status\r",
          "    status: pm.response.code < 400 ? \"PASS\" : \"FAIL\",\r",
          "\r",
          "    // New SLA Fields\r",
          "    slaLimit: SLA_LIMIT,\r",
          "    slaStatus: pm.response.responseTime < SLA_LIMIT ? \"PASS\" : \"FAIL\",\r",
          "\r",
          "    timestamp: new Date().toISOString()\r",
          "};\r",
          "\r",
          "pm.sendRequest({\r",
          "    url: \"http://localhost:5000\",\r",
          "    method: \"POST\",\r",
          "    header: {\r",
          "        \"Content-Type\": \"application/json\"\r",
          "    },\r",
          "    body: {\r",
          "        mode: \"raw\",\r",
          "        raw: JSON.stringify(elkData)\r",
          "    }\r",
          "});"
        ]
      }
    }
  ]
}